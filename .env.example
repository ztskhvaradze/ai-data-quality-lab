# Copy this file to .env and fill in your own values. Never commit .env.
# Without an API key the app still works in the clearly labelled deterministic demo mode.

# anthropic (default) or openai
AI_PROVIDER=anthropic

# Anthropic: create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Alternative to ANTHROPIC_API_KEY: a gateway/proxy token and URL.
# Claude Code via CodeMie sets these automatically for its own session.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=

# OpenAI (used when AI_PROVIDER=openai): create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model override. Defaults: anthropic -> claude-opus-5-5, openai -> gpt-5-mini
# AI_MODEL=

# Seconds before a live call gives up (default 20)
# AI_TIMEOUT_SECONDS=20
